# What the OpenCL driver in this repository is built from. A pin, not a
# suggestion: every number in STATE.md names the commit it was measured at.
#
# Mesa: branch "opencl" of the fork, on top of got-bringup's pinned
# local-deploy commit (d105715), so one fork carries both the Honeykrisp
# (Vulkan) and the Rusticl (OpenCL) work.
MESA_REPO="https://github.com/aquarat/mesa"
MESA_BRANCH="opencl"
MESA_COMMIT="51e56cafb6be60034c4a7586ad3593ee88572521"
MESA_VERSION="26.3.0"

# mesa-libclc: Karol Herbst's pinned libclc fork, embedded into the driver.
# The branch must match the build container's clang major version (Fedora 44:
# clang 22).
LIBCLC_REPO="https://gitlab.freedesktop.org/karolherbst/mesa-libclc.git"
LIBCLC_BRANCH="llvm_22"
LIBCLC_COMMIT="87f66007242ff10e9e84bf32be84f9057f6abc75"
